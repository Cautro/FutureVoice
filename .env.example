# PostgreSQL (Docker)
POSTGRES_DB=futurevoice
POSTGRES_USER=futurevoice
POSTGRES_PASSWORD=replace_with_a_long_random_password

# Telegram Bot API
BOT_TOKEN=replace_with_botfather_token

# Shared secret between Telegram process and backend
BOT_API_SECRET=replace_with_a_long_random_secret

# Internal Docker address
BACKEND_URL=http://backend:8080

# Backend
PORT=8080

# PostgreSQL connection string
DATABASE_URL=postgres://futurevoice:replace_with_a_long_random_password@postgres:5432/futurevoice?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Telegram OIDC
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/telegram/callback

ADMIN_WEB_URL=http://localhost:8080

COOKIE_SECURE=false
ADMIN_SESSION_TTL=8h

# Monitoring
METRICS_USER=prometheus
METRICS_PASSWORD=replace_with_a_long_random_metrics_password

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace_with_a_different_long_random_password